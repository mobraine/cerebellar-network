<mujoco model="humanoid2d">
  <!-- 平面 (矢状面) 人形机器人: 根关节 = x/z 平移 + y 轴俯仰,
       双腿各 髋/膝/踝 3 关节 (y 轴), 躯干+头+双臂 (固定形态)。
       形态是人形, 动力学约束在 2D 平面 —— 双足平衡研究的标准简化。 -->
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="0 0 0.1" friction="1.0 0.1 0.1"
          rgba="0.3 0.3 0.35 1"/>
    <body name="torso" pos="0 0 0.98">
      <joint name="root_x" type="slide" axis="1 0 0"/>
      <joint name="root_z" type="slide" axis="0 0 1"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0"/>
      <geom name="pelvis" type="box" size="0.09 0.11 0.07" pos="0 0 -0.02"
            mass="8" rgba="0.2 0.4 0.8 1"/>
      <geom name="chest" type="capsule" fromto="0 0 0.0 0 0 0.52"
            size="0.10" mass="20" rgba="0.2 0.5 0.9 1"/>
      <geom name="head" type="sphere" size="0.09" pos="0 0 0.70"
            mass="4" rgba="0.9 0.8 0.6 1"/>
      <geom name="arm_l" type="capsule" fromto="0 0.24 0.45 0 0.30 -0.15"
            size="0.035" mass="3" rgba="0.2 0.5 0.9 1"/>
      <geom name="arm_r" type="capsule" fromto="0 -0.24 0.45 0 -0.30 -0.15"
            size="0.035" mass="3" rgba="0.2 0.5 0.9 1"/>
      <body name="thigh_l" pos="0 0.10 -0.05">
        <joint name="hip_l" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.45" size="0.05"
              mass="7" rgba="0.3 0.3 0.35 1"/>
        <body name="shin_l" pos="0 0 -0.45">
          <joint name="knee_l" type="hinge" axis="0 1 0" range="-2.2 0.1"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.43" size="0.04"
                mass="4" rgba="0.3 0.3 0.4 1"/>
          <body name="foot_l" pos="0 0 -0.43">
            <joint name="ankle_l" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom type="box" size="0.14 0.045 0.025" pos="0.05 0 -0.045"
                  mass="1.5" rgba="0.15 0.15 0.15 1"/>
          </body>
        </body>
      </body>
      <body name="thigh_r" pos="0 -0.10 -0.05">
        <joint name="hip_r" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.45" size="0.05"
              mass="7" rgba="0.3 0.3 0.35 1"/>
        <body name="shin_r" pos="0 0 -0.45">
          <joint name="knee_r" type="hinge" axis="0 1 0" range="-2.2 0.1"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.43" size="0.04"
                mass="4" rgba="0.3 0.3 0.4 1"/>
          <body name="foot_r" pos="0 0 -0.43">
            <joint name="ankle_r" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom type="box" size="0.14 0.045 0.025" pos="0.05 0 -0.045"
                  mass="1.5" rgba="0.15 0.15 0.15 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="m_hip_l" joint="hip_l" gear="120" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="m_knee_l" joint="knee_l" gear="120" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="m_ankle_l" joint="ankle_l" gear="70" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="m_hip_r" joint="hip_r" gear="120" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="m_knee_r" joint="knee_r" gear="120" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="m_ankle_r" joint="ankle_r" gear="70" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
